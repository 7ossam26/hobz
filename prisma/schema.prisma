// Agency OS schema.
//
// Phase 0 laid the identity/access/audit/settings core (SPEC §4 "Identity &
// access" + §7). Phase 3 added the first slice of "Work" (SPEC §4): Client,
// Project, ProjectMember, Milestone, ProjectTemplate. Phase 4 added the Task
// domain: Task, TaskWatcher, TaskDependency, TaskComment, TaskActivity.
// Phase 6 adds the Calendar slice — Holiday, Leave — plus ExtensionRequest and
// the task columns the nightly lateness job writes. Money models still arrive
// in their own phase — do not add them here ahead of schedule.
//
// Structural invariants this schema must keep possible (CLAUDE.md):
//  - Money columns are always Decimal(12,2), never Float.
//  - Soft-delete via `deletedAt` on every user-owned entity — except a couple
//    of junction tables the SPEC §4 listing itself omits it from
//    (ProjectMember here, matching UserRole/RolePermission from Phase 0).
//  - AuditLog is append-only: no `updatedAt`, no mutation paths in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// How a user is paid. Attaches to the user, never to the role (SPEC §2).
enum PayType {
  SALARY
  PER_TASK
  HYBRID
}

model User {
  id                 String  @id @default(cuid())
  username           String  @unique
  passwordHash       String
  fullName           String
  /// E.164, normalised to +20… on write. Never used for email/SMS — WhatsApp
  /// deep links only (SPEC §8).
  phone              String?
  isWorker           Boolean @default(false)
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(false)
  timezone           String  @default("Africa/Cairo")

  payType             PayType  @default(PER_TASK)
  monthlySalary       Decimal? @db.Decimal(12, 2)
  defaultTaskRate     Decimal? @db.Decimal(12, 2)
  weeklyCapacityHours Int      @default(40)

  /// Per-user penalty formula override (SPEC R2). The PenaltyProfile table
  /// itself lands in Phase 8; this column is the seam, deliberately unconstrained.
  penaltyProfileId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles             UserRole[]
  auditEvents       AuditLog[] @relation("AuditActor")
  auditImpersonated AuditLog[] @relation("AuditImpersonator")
  settingsTouched   Setting[]  @relation("SettingUpdatedBy")

  ownedProjects      Project[]         @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  createdTemplates   ProjectTemplate[] @relation("ProjectTemplateCreatedBy")

  assignedTasks Task[]         @relation("TaskAssignee")
  watchedTasks  TaskWatcher[]
  taskComments  TaskComment[]  @relation("TaskCommentAuthor")
  taskActivity  TaskActivity[] @relation("TaskActivityActor")

  leave              Leave[]            @relation("LeaveSubject")
  leaveRequested     Leave[]            @relation("LeaveRequestedBy")
  leaveDecided       Leave[]            @relation("LeaveDecidedBy")
  extensionsRequested ExtensionRequest[] @relation("ExtensionRequestedBy")
  extensionsDecided   ExtensionRequest[] @relation("ExtensionDecidedBy")

  @@index([deletedAt])
  @@index([isWorker, isActive])
  @@map("users")
}

/// Roles are created and named in the UI. The permission *catalog* is code
/// (SPEC §6); which permissions a role holds is data.
model Role {
  id          String    @id @default(cuid())
  /// Stable machine identifier. `SUPER_ADMIN` is reserved and hardcoded.
  nameEn      String    @unique
  nameAr      String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

/// Seeded from the code catalog in lib/rbac. Never user-editable.
model Permission {
  key           String @id
  /// Domain prefix ("task", "payout") used to group the role editor UI.
  domain        String
  descriptionAr String

  roles RolePermission[]

  @@index([domain])
  @@map("permissions")
}

model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// APPEND-ONLY. Never updated, never deleted. There is intentionally no
/// `updatedAt` and no `deletedAt` — their absence is the schema-level statement
/// of that invariant.
model AuditLog {
  id             String  @id @default(cuid())
  /// Null only for system/scheduler actions.
  actorId        String?
  /// The real SUPER_ADMIN behind an impersonated session (SPEC Phase 1 §5).
  /// A column rather than a key inside `after`, for two reasons: `after` stays
  /// a clean before/after diff, and "show me everything done while
  /// impersonating" becomes an indexed query instead of a JSON scan.
  impersonatorId String?
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ip             String?

  createdAt DateTime @default(now())

  actor        User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  impersonator User? @relation("AuditImpersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([impersonatorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// The durable half of the login limiter (lib/auth/rate-limit).
///
/// Keyed by `user:<username>` or `ip:<address>` — both, so that one attacker
/// cannot lock every account out of the product by hammering usernames, and a
/// botnet cannot spread a run thin enough across IPs to never trip.
///
/// Not an audit table: rows are updated and deleted freely, and a successful
/// login clears its own. The permanent record of a login attempt is the
/// AuditLog row, which is append-only.
model LoginThrottle {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @default(now())
  lastFailureAt  DateTime  @default(now())
  lockedUntil    DateTime?

  /// Lets a periodic sweep drop expired rows without a table scan.
  @@index([lockedUntil])
  @@index([lastFailureAt])
  @@map("login_throttles")
}

/// Every business number in the product lives here (CLAUDE.md invariant 4).
/// `value` is untyped JSON at the DB level and Zod-validated in lib/settings —
/// the catalog in code is the schema of record.
model Setting {
  key         String   @id
  value       Json
  /// Grouping key for the settings page sections (SPEC §7).
  group       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────────────
// Work — Phase 3 slice (SPEC §4 "Work"). Task and its satellites are Phase 4.
// ─────────────────────────────────────────────────────────────────────────

/// Fixed per SPEC §4 enum list. The Arabic *label* per value is editable in
/// Settings (`labels.projectStatus`); the values themselves are not (SPEC §2).
enum ProjectStatus {
  DRAFT
  PROPOSED
  ACTIVE
  ON_HOLD
  IN_REVIEW
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// Fixed per SPEC §4. Which of the four are offered per project is the
/// Settings-configurable list (`projects.engagementTypes`) the phase brief
/// refers to — the enum itself does not change (SPEC §2).
enum EngagementType {
  FIXED_PRICE
  RETAINER
  MILESTONE_BASED
  HOURLY
}

/// RAG (SPEC §5.7). Also the shape of a manual override — see
/// `Project.healthOverride`.
enum ProjectHealth {
  GREEN
  AMBER
  RED
}

/// A project's team role. Independent of the RBAC `Role` a user holds
/// (CLAUDE.md architecture: permissions are global; this is per-project
/// context only, e.g. for a future "who can approve on this project" rule).
/// Not in the SPEC §4 enum list — a Phase 3 addition, recorded in
/// docs/DECISIONS.md.
enum ProjectMemberRole {
  MANAGER
  CONTRIBUTOR
  VIEWER
}

/// Not in the SPEC §4 enum list either — recorded in docs/DECISIONS.md.
enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  DELAYED
}

/// Lightweight label on a project (SPEC §2 Locked decisions: "Clients never
/// log in... No money-in tracking"). Deliberately thin — CLAUDE.md forbids
/// financial tracking, invoices or payments here.
model Client {
  id        String    @id @default(cuid())
  name      String
  /// E.164, normalised on write — the WhatsApp deep link input (SPEC §8).
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@index([deletedAt])
  @@map("clients")
}

model Project {
  id String @id @default(cuid())

  /// Auto-generated on create (`modules/project/code.ts`), editable after.
  code String @unique
  name String

  clientId String?
  ownerId  String

  engagementType EngagementType
  status         ProjectStatus  @default(DRAFT)

  /// Required per the SPEC §4 listing (no `?` on either field there, unlike
  /// `clientId?`/`healthOverride?`/etc. next to them).
  startDate DateTime
  dueDate   DateTime

  /// Overrides Settings `penalty.defaultGraceHours` when set (SPEC §5.3:
  /// "Grace: project override → global default").
  gracePeriodHours         Int?
  /// Overrides Settings `penalty.penalizeRevisionLateness` when set (SPEC T4).
  penalizeRevisionLateness Boolean?

  /// Manual RAG override (SPEC §5.7). `healthReason` is mandatory whenever
  /// `healthOverride` is non-null — enforced in `modules/project/schema.ts`
  /// and `service.ts`, not at the DB level, so a *clearing* write (both null)
  /// is still a valid row.
  healthOverride ProjectHealth?
  healthReason   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]

  @@index([deletedAt])
  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@map("projects")
}

/// A project's team, each with a per-project role (SPEC §4: "members with
/// per-project role"). No `deletedAt` — the SPEC §4 listing omits it here
/// exactly as it does for `UserRole`/`RolePermission`; membership is added and
/// removed outright, like a role assignment.
///
/// `scopeProjects()` (lib/rbac) reads this table by its `members` relation
/// name and `userId` field — both fixed by the contract
/// `tests/integration/rbac/scoped-reads.test.ts` already asserts.
model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  addedAt   DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// SPEC §4: "name, due date, order, status". No `deletedAt` in the SPEC
/// listing — removed outright, cascading with the project.
model Milestone {
  id        String          @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  order     Int
  status    MilestoneStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, order])
  @@map("milestones")
}

/// SPEC §4: "spawns milestones+tasks". `payload` carries the milestone shape
/// today; a `tasks` array is reserved in the payload type
/// (`modules/project-template/types.ts`) and stays empty until Phase 4 gives
/// this module a real `Task` to capture — the same "define the interface now,
/// no-op the seam" shape Phase 1 used for `OpenTaskLookup`.
model ProjectTemplate {
  id      String @id @default(cuid())
  name    String
  payload Json

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User? @relation("ProjectTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("project_templates")
}

// ─────────────────────────────────────────────────────────────────────────
// Work — Phase 4 slice: the Task domain (SPEC §4 "Work", §5.1, §5.2).
// ExtensionRequest belongs to Phase 6, which owns the lateness engine it
// feeds; `Task.originalDueDate` below is the seam it will write against.
// ─────────────────────────────────────────────────────────────────────────

/// Fixed per SPEC §4. Arabic labels are editable in Settings
/// (`labels.taskStatus`); the values are not (SPEC §2). The legal moves
/// between them are SPEC §5.1, enforced in `modules/task/state-machine.ts`.
enum TaskStatus {
  BACKLOG
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  DONE
  BLOCKED
  CANCELLED
}

/// Fixed per SPEC §4. Label editable via `labels.priority`.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Fixed per SPEC §4. Who a delay is *attributed* to — recorded for reporting
/// only. It deliberately does not feed the penalty engine (SPEC §5.4 computes
/// from `lateWorkingDays` and the user's profile, nothing else); a manager
/// re-attributing a delay must never quietly change someone's deduction.
enum DelayAttribution {
  WORKER
  CLIENT
  INTERNAL
  DEPENDENCY
}

/// The activity feed's vocabulary. Not a SPEC §4 enum — SPEC types
/// `TaskActivity.type` loosely — so the values are recorded in
/// docs/DECISIONS.md alongside `ProjectMemberRole`/`MilestoneStatus`.
///
/// `from`/`to` carry the change as strings, whatever the type: statuses for
/// STATUS_CHANGED, user ids for ASSIGNED, ISO instants for DUE_DATE_CHANGED.
/// SPEC §4 gives the row exactly `type, from, to` and no metadata column, and
/// that constraint is kept — anything richer belongs in the AuditLog row the
/// same operation writes.
enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  WATCHER_ADDED
  WATCHER_REMOVED
  COMMENTED
  DUE_DATE_CHANGED
  VALUE_CHANGED
  UPDATED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  ELAPSED_RECOMPUTED
}

model Task {
  id          String  @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?

  /// The one accountable person (SPEC §4 `assigneeId?`). Watchers are the
  /// many; see `TaskWatcher`. Null only while the task sits in BACKLOG.
  assigneeId String?

  status   TaskStatus @default(BACKLOG)
  priority Priority   @default(MEDIUM)

  /// Stable id of a Settings-defined category (`tasks.categories`), not its
  /// Arabic label — so renaming a category in Settings never orphans a task.
  /// Required, per the SPEC §4 listing (no `?`, unlike `milestoneId?` and
  /// `assigneeId?` beside it); validated against the live Settings list on
  /// write. See docs/DECISIONS.md (Phase 4).
  categoryId String

  /// Hours, not money — but `Decimal` all the same: it is divided by working
  /// elapsed time for the estimate-accuracy score (SPEC §5.6), and a float
  /// there would drift the same way a float payout would.
  estimatedHours Decimal @default(0) @db.Decimal(6, 2)

  /// What the assignee earns on approval (SPEC §5.1: "APPROVED is the only
  /// event that creates an EARNING ledger entry"). Auto-filled from the
  /// assignee's `defaultTaskRate` on assignment, editable per task.
  taskValue Decimal @default(0) @db.Decimal(12, 2)

  /// Required, per the SPEC §4 listing (no `?`, unlike `assigneeId?` beside
  /// it) and because the whole lateness engine measures against it.
  dueDate         DateTime
  /// The deadline the task was first given. An approved extension (Phase 6)
  /// moves `dueDate` and leaves this alone (SPEC §5.3).
  originalDueDate DateTime

  /// Stamped by the state machine, never by hand. `assignedAt`, `startedAt`
  /// and `approvedAt` are stamped once and never overwritten; `submittedAt` is
  /// re-stamped by every re-submission, with the original preserved in
  /// `TaskActivity` (SPEC §5.1).
  assignedAt  DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?

  /// Denormalised, job-updated (SPEC §4). Raw is wall-clock; working excludes
  /// weekends, holidays and approved leave via `lib/calendar` (SPEC §5.2).
  /// Derived values only — `modules/task/elapsed.ts` is the one writer.
  elapsedMinutesRaw     Int @default(0)
  elapsedMinutesWorking Int @default(0)

  /// Denormalised in the same sense as the two columns above, and written by
  /// the same nightly job (Phase 6, `modules/calendar/job.ts`): how many
  /// working days past `dueDate + grace` this task is, and how far that has
  /// escalated under the Settings thresholds (SPEC §8). Derived values only —
  /// the authority is always `modules/lateness/service.ts` recomputing from
  /// `lib/calendar`. They exist so the escalation decision is auditable and so
  /// project health can read "is anything escalated here" as an indexed count
  /// rather than by walking the calendar for every task on every dashboard.
  overdueWorkingDays Int             @default(0)
  escalationLevel    EscalationLevel @default(NONE)
  escalatedAt        DateTime?

  delayReason      String?
  delayAttribution DelayAttribution?

  /// 1–5, captured on approval and feeding the performance score (SPEC §5.6).
  /// Not in the SPEC §4 Task listing — a Phase 4 addition, recorded in
  /// docs/DECISIONS.md and added to SPEC §4.
  qualityRating Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project      Project          @relation(fields: [projectId], references: [id])
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  watchers     TaskWatcher[]
  comments     TaskComment[]
  activity     TaskActivity[]
  extensions   ExtensionRequest[]
  /// Tasks this one waits on, and the ones waiting on it.
  dependencies TaskDependency[] @relation("TaskDependent")
  dependents   TaskDependency[] @relation("TaskDependedOn")

  @@index([deletedAt])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([milestoneId])
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([priority])
  @@index([categoryId])
  @@index([projectId, escalationLevel])
  @@map("tasks")
}

/// The many, to the assignee's one. Watchers see the task under
/// `task.view.assigned` (SPEC §6) and are notified about it (SPEC §8), but are
/// not accountable for it and never earn from it.
///
/// No `deletedAt`, matching `ProjectMember`/`UserRole`: a watcher is added and
/// removed outright.
model TaskWatcher {
  taskId  String
  userId  String
  addedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

/// Finish-to-start, **warning only, never blocking** (SPEC §4, §5.1). There is
/// deliberately no database constraint or application guard that stops a task
/// starting while `dependsOnTask` is unapproved — the product surfaces a banner
/// and lets the human decide.
model TaskDependency {
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task          Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependedOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// SPEC §4: `id, taskId, authorId, body, mentions[]`. No attachments, no
/// uploads — the only file input in the product is in-memory `.xlsx`
/// (CLAUDE.md invariant 9).
///
/// `mentions` holds resolved user ids, not the raw `@handles`: the handle is a
/// display detail that a rename would break, and the id is what the notifier
/// (Phase 9) actually needs.
model TaskComment {
  id       String   @id @default(cuid())
  taskId   String
  authorId String
  body     String
  mentions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

/// The human-readable history of one task (SPEC §4). Distinct from `AuditLog`,
/// and both are written: the audit row is the compliance record (actor, ip,
/// before/after diff, queryable across entities), this is the feed a منفّذ
/// reads on the task itself.
///
/// Append-only in practice — nothing updates or deletes a row — because
/// SPEC §5.1 makes it load-bearing: it is where a task's *original*
/// `submittedAt` survives re-submission, and where `BLOCKED → previous`
/// recovers what "previous" was.
model TaskActivity {
  id      String           @id @default(cuid())
  taskId  String
  /// Null for scheduler/system activity (the elapsed-time recompute job).
  actorId String?
  type    TaskActivityType
  from    String?
  to      String?

  /// Set explicitly from the operation's `now`, never left to the database
  /// clock: this column *is* the historical timestamp the SPEC relies on.
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([taskId, type, createdAt])
  @@index([actorId])
  @@map("task_activity")
}

// ─────────────────────────────────────────────────────────────────────────
// Calendar — Phase 6 slice (SPEC §4 "Calendar", §5.2, §5.3).
//
// SPEC §4 lists three things here: `WorkCalendar`, `Holiday` and `Leave`.
// Only two of them are tables. **`WorkCalendar` is not a model** — weekend
// days, workday bounds and working-days-per-month are already Settings keys
// (`calendar.*`, SPEC §7), and CLAUDE.md invariant 4 says every business
// number comes from `lib/settings`. A second, authoritative copy in a
// single-row table would be exactly the drift that invariant exists to stop.
// `lib/calendar` materialises the Settings group into a `WorkCalendar` value
// object instead — the shape SPEC §4 describes, sourced where §7 says.
//
// Dates here are `@db.Date`, not `DateTime`. A holiday and a leave range are
// *calendar dates in Cairo*, not instants: "7 يناير is a holiday" is true for
// the whole Cairo day, and storing 00:00Z would make that statement depend on
// which side of midnight a reader's timezone sits. `lib/calendar` is the one
// place that converts between a Cairo date key and a UTC instant.
// ─────────────────────────────────────────────────────────────────────────

/// SPEC §4 gives `Leave … status` without enumerating it. Three values, and
/// no CANCELLED: the phase brief's vocabulary is "approve/reject", and a
/// request withdrawn before a decision is rejected by whoever handles it. A
/// fourth value would be a second way to say "this leave does not apply",
/// which is one more state every lateness query has to remember to exclude.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// SPEC §4 lists this one verbatim: `status(PENDING|APPROVED|REJECTED)`.
enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// How far an overdue task has escalated (SPEC §8; thresholds in Settings,
/// `notifications.escalateToPmAfterDays` / `…AdminAfterDays`).
///
/// Stored rather than derived on read because the escalation *event* — the
/// notification Phase 9 delivers — must fire exactly once per level change.
/// A value recomputed on every read has no way to know it has already fired.
enum EscalationLevel {
  NONE
  PM
  ADMIN
}

/// SPEC §4: `Holiday id, date, nameAr`. Plus `isRecurring`, which the phase
/// brief asks for: عيد الميلاد المجيد falls on 7 January every year, while
/// عيد الفطر moves and must be entered per year.
///
/// No `deletedAt`, matching `Milestone` and the SPEC §4 listing. A holiday is
/// calendar configuration, not a record of anything that happened: a
/// soft-deleted one that a query forgot to filter would keep being a day off,
/// which is the failure mode soft-delete is supposed to prevent, inverted.
model Holiday {
  id     String   @id @default(cuid())
  /// Cairo calendar date. For a recurring holiday the year is the first
  /// occurrence and only month/day are matched.
  date   DateTime @db.Date
  nameAr String

  isRecurring Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per date. Overlapping *coverage* (a one-off inside a recurring
  /// holiday's month/day) is rejected in the service, where recurrence can be
  /// reasoned about; this constraint is the backstop for the exact-duplicate
  /// case a race could still produce.
  @@unique([date])
  @@index([isRecurring])
  @@map("holidays")
}

/// SPEC §4: `Leave id, userId, startDate, endDate, type, status, note`.
///
/// Three columns are added to that listing and each earns its place: leave is
/// approved by someone (`decidedById`/`decidedAt`, the same pair SPEC §4 gives
/// `ExtensionRequest`), and it can be *recorded* for a منفّذ by a manager
/// rather than requested by them (`requestedById`), which is the difference
/// between "أحمد asked for Thursday off" and "أحمد was out sick and المدير
/// logged it".
///
/// `startDate`/`endDate` are **inclusive** Cairo dates. A one-day leave has
/// `startDate == endDate`; there is no zero-length leave.
model Leave {
  id     String @id @default(cuid())
  /// Whose leave it is — the person the calendar excludes days for.
  userId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// Stable id from Settings `calendar.leaveTypes`, never the Arabic label —
  /// the same split SPEC §7 settled for `tasks.categories` in Phase 4, so
  /// renaming a leave type is a label change and not a re-typing of history.
  typeId String

  status LeaveStatus @default(PENDING)
  note   String?

  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User  @relation("LeaveSubject", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// The calendar's hot path: "APPROVED leave for this user overlapping this
  /// range". Overlap is `startDate <= to AND endDate >= from`, so both bounds
  /// are in the index.
  @@index([userId, status, startDate, endDate])
  @@index([status, startDate])
  @@index([requestedById])
  @@map("leaves")
}

/// SPEC §4, verbatim: `id, taskId, requestedById, oldDueDate, newDueDate,
/// reason, status, decidedById`.
///
/// `oldDueDate` is not decoration. It is the optimistic-concurrency check on
/// approval: if the task's deadline moved between request and decision — a
/// revision (SPEC T4) or another extension — the request is stale and
/// approving it would silently overwrite a newer decision.
model ExtensionRequest {
  id     String @id @default(cuid())
  taskId String

  requestedById String
  oldDueDate    DateTime
  newDueDate    DateTime
  reason        String

  status       ExtensionStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ExtensionRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("ExtensionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([status, createdAt])
  @@index([requestedById])
  @@map("extension_requests")
}
