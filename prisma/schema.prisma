// Virallap schema.
//
// Phase 0 laid the identity/access/audit/settings core (SPEC §4 "Identity &
// access" + §7). Phase 3 added the first slice of "Work" (SPEC §4): Client,
// Project, ProjectMember, Milestone, ProjectTemplate. Phase 4 added the Task
// domain: Task, TaskWatcher, TaskDependency, TaskComment, TaskActivity.
// Phase 6 adds the Calendar slice — Holiday, Leave — plus ExtensionRequest and
// the task columns the nightly lateness job writes. Phase 7 adds the Money
// slice: LedgerEntry, PayoutCycle, Payout.
//
// Structural invariants this schema must keep possible (CLAUDE.md):
//  - Money columns are always Decimal(12,2), never Float.
//  - Soft-delete via `deletedAt` on every user-owned entity — except a couple
//    of junction tables the SPEC §4 listing itself omits it from
//    (ProjectMember here, matching UserRole/RolePermission from Phase 0).
//  - AuditLog is append-only: no `updatedAt`, no mutation paths in code.
//  - LedgerEntry is append-only *and enforced by the database* — see the
//    "Objects this schema cannot express" note at the bottom of this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// How a user is paid. Attaches to the user, never to the role (SPEC §2).
enum PayType {
  SALARY
  PER_TASK
  HYBRID
}

model User {
  id                 String  @id @default(cuid())
  username           String  @unique
  passwordHash       String
  fullName           String
  /// E.164, normalised to +20… on write. Never used for email/SMS — WhatsApp
  /// deep links only (SPEC §8).
  phone              String?
  isWorker           Boolean @default(false)
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(false)
  timezone           String  @default("Africa/Cairo")

  payType             PayType  @default(PER_TASK)
  monthlySalary       Decimal? @db.Decimal(12, 2)
  defaultTaskRate     Decimal? @db.Decimal(12, 2)
  weeklyCapacityHours Int      @default(40)

  /// Per-user penalty formula override (SPEC R2). Null means "the agency
  /// default", which lives in Settings (`penalty.default*`) and not in a row —
  /// see the note on `PenaltyProfile`. Phase 8 turned the Phase-0 seam into a
  /// real foreign key.
  penaltyProfileId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles             UserRole[]
  auditEvents       AuditLog[] @relation("AuditActor")
  auditImpersonated AuditLog[] @relation("AuditImpersonator")
  settingsTouched   Setting[]  @relation("SettingUpdatedBy")

  ownedProjects      Project[]         @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  createdTemplates   ProjectTemplate[] @relation("ProjectTemplateCreatedBy")

  assignedTasks Task[]         @relation("TaskAssignee")
  watchedTasks  TaskWatcher[]
  taskComments  TaskComment[]  @relation("TaskCommentAuthor")
  taskActivity  TaskActivity[] @relation("TaskActivityActor")

  leave               Leave[]            @relation("LeaveSubject")
  leaveRequested      Leave[]            @relation("LeaveRequestedBy")
  leaveDecided        Leave[]            @relation("LeaveDecidedBy")
  extensionsRequested ExtensionRequest[] @relation("ExtensionRequestedBy")
  extensionsDecided   ExtensionRequest[] @relation("ExtensionDecidedBy")

  ledgerEntries        LedgerEntry[] @relation("LedgerSubject")
  ledgerEntriesCreated LedgerEntry[] @relation("LedgerCreatedBy")
  payouts              Payout[]      @relation("PayoutSubject")
  payoutsApproved      Payout[]      @relation("PayoutApprovedBy")
  payoutsPaid          Payout[]      @relation("PayoutPaidBy")
  cyclesClosed         PayoutCycle[] @relation("PayoutCycleClosedBy")

  notifications           Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceOwner")

  performanceScore PerformanceScore?

  penaltyProfile PenaltyProfile? @relation(fields: [penaltyProfileId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([isWorker, isActive])
  @@index([penaltyProfileId])
  @@map("users")
}

/// Roles are created and named in the UI. The permission *catalog* is code
/// (SPEC §6); which permissions a role holds is data.
model Role {
  id          String    @id @default(cuid())
  /// Stable machine identifier. `SUPER_ADMIN` is reserved and hardcoded.
  nameEn      String    @unique
  nameAr      String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

/// Seeded from the code catalog in lib/rbac. Never user-editable.
model Permission {
  key           String @id
  /// Domain prefix ("task", "payout") used to group the role editor UI.
  domain        String
  descriptionAr String

  roles RolePermission[]

  @@index([domain])
  @@map("permissions")
}

model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// APPEND-ONLY. Never updated, never deleted. There is intentionally no
/// `updatedAt` and no `deletedAt` — their absence is the schema-level statement
/// of that invariant.
model AuditLog {
  id             String  @id @default(cuid())
  /// Null only for system/scheduler actions.
  actorId        String?
  /// The real SUPER_ADMIN behind an impersonated session (SPEC Phase 1 §5).
  /// A column rather than a key inside `after`, for two reasons: `after` stays
  /// a clean before/after diff, and "show me everything done while
  /// impersonating" becomes an indexed query instead of a JSON scan.
  impersonatorId String?
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ip             String?

  createdAt DateTime @default(now())

  actor        User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  impersonator User? @relation("AuditImpersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([impersonatorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// The durable half of the login limiter (lib/auth/rate-limit).
///
/// Keyed by `user:<username>` or `ip:<address>` — both, so that one attacker
/// cannot lock every account out of the product by hammering usernames, and a
/// botnet cannot spread a run thin enough across IPs to never trip.
///
/// Not an audit table: rows are updated and deleted freely, and a successful
/// login clears its own. The permanent record of a login attempt is the
/// AuditLog row, which is append-only.
model LoginThrottle {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @default(now())
  lastFailureAt  DateTime  @default(now())
  lockedUntil    DateTime?

  /// Lets a periodic sweep drop expired rows without a table scan.
  @@index([lockedUntil])
  @@index([lastFailureAt])
  @@map("login_throttles")
}

/// Every business number in the product lives here (CLAUDE.md invariant 4).
/// `value` is untyped JSON at the DB level and Zod-validated in lib/settings —
/// the catalog in code is the schema of record.
model Setting {
  key         String   @id
  value       Json
  /// Grouping key for the settings page sections (SPEC §7).
  group       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────────────
// Work — Phase 3 slice (SPEC §4 "Work"). Task and its satellites are Phase 4.
// ─────────────────────────────────────────────────────────────────────────

/// Fixed per SPEC §4 enum list. The Arabic *label* per value is editable in
/// Settings (`labels.projectStatus`); the values themselves are not (SPEC §2).
enum ProjectStatus {
  DRAFT
  PROPOSED
  ACTIVE
  ON_HOLD
  IN_REVIEW
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// Fixed per SPEC §4. Which of the four are offered per project is the
/// Settings-configurable list (`projects.engagementTypes`) the phase brief
/// refers to — the enum itself does not change (SPEC §2).
enum EngagementType {
  FIXED_PRICE
  RETAINER
  MILESTONE_BASED
  HOURLY
}

/// RAG (SPEC §5.7). Also the shape of a manual override — see
/// `Project.healthOverride`.
enum ProjectHealth {
  GREEN
  AMBER
  RED
}

/// A project's team role. Independent of the RBAC `Role` a user holds
/// (CLAUDE.md architecture: permissions are global; this is per-project
/// context only, e.g. for a future "who can approve on this project" rule).
/// Not in the SPEC §4 enum list — a Phase 3 addition, recorded in
/// docs/DECISIONS.md.
enum ProjectMemberRole {
  MANAGER
  CONTRIBUTOR
  VIEWER
}

/// Not in the SPEC §4 enum list either — recorded in docs/DECISIONS.md.
enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  DELAYED
}

/// Lightweight label on a project (SPEC §2 Locked decisions: "Clients never
/// log in... No money-in tracking"). Deliberately thin — CLAUDE.md forbids
/// financial tracking, invoices or payments here.
model Client {
  id        String    @id @default(cuid())
  name      String
  /// E.164, normalised on write — the WhatsApp deep link input (SPEC §8).
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@index([deletedAt])
  @@map("clients")
}

model Project {
  id String @id @default(cuid())

  /// Auto-generated on create (`modules/project/code.ts`), editable after.
  code String @unique
  name String

  clientId String?
  ownerId  String

  engagementType EngagementType
  status         ProjectStatus  @default(DRAFT)

  /// Required per the SPEC §4 listing (no `?` on either field there, unlike
  /// `clientId?`/`healthOverride?`/etc. next to them).
  startDate DateTime
  dueDate   DateTime

  /// Overrides Settings `penalty.defaultGraceHours` when set (SPEC §5.3:
  /// "Grace: project override → global default").
  gracePeriodHours         Int?
  /// Overrides Settings `penalty.penalizeRevisionLateness` when set (SPEC T4).
  penalizeRevisionLateness Boolean?

  /// Manual RAG override (SPEC §5.7). `healthReason` is mandatory whenever
  /// `healthOverride` is non-null — enforced in `modules/project/schema.ts`
  /// and `service.ts`, not at the DB level, so a *clearing* write (both null)
  /// is still a valid row.
  healthOverride ProjectHealth?
  healthReason   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]

  @@index([deletedAt])
  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@map("projects")
}

/// A project's team, each with a per-project role (SPEC §4: "members with
/// per-project role"). No `deletedAt` — the SPEC §4 listing omits it here
/// exactly as it does for `UserRole`/`RolePermission`; membership is added and
/// removed outright, like a role assignment.
///
/// `scopeProjects()` (lib/rbac) reads this table by its `members` relation
/// name and `userId` field — both fixed by the contract
/// `tests/integration/rbac/scoped-reads.test.ts` already asserts.
model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTOR)
  addedAt   DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// SPEC §4: "name, due date, order, status". No `deletedAt` in the SPEC
/// listing — removed outright, cascading with the project.
model Milestone {
  id        String          @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  order     Int
  status    MilestoneStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, order])
  @@map("milestones")
}

/// SPEC §4: "spawns milestones+tasks". `payload` carries the milestone shape
/// today; a `tasks` array is reserved in the payload type
/// (`modules/project-template/types.ts`) and stays empty until Phase 4 gives
/// this module a real `Task` to capture — the same "define the interface now,
/// no-op the seam" shape Phase 1 used for `OpenTaskLookup`.
model ProjectTemplate {
  id      String @id @default(cuid())
  name    String
  payload Json

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User? @relation("ProjectTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("project_templates")
}

// ─────────────────────────────────────────────────────────────────────────
// Work — Phase 4 slice: the Task domain (SPEC §4 "Work", §5.1, §5.2).
// ExtensionRequest belongs to Phase 6, which owns the lateness engine it
// feeds; `Task.originalDueDate` below is the seam it will write against.
// ─────────────────────────────────────────────────────────────────────────

/// Fixed per SPEC §4. Arabic labels are editable in Settings
/// (`labels.taskStatus`); the values are not (SPEC §2). The legal moves
/// between them are SPEC §5.1, enforced in `modules/task/state-machine.ts`.
enum TaskStatus {
  BACKLOG
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  DONE
  BLOCKED
  CANCELLED
}

/// Fixed per SPEC §4. Label editable via `labels.priority`.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Fixed per SPEC §4. Who a delay is *attributed* to — recorded for reporting
/// only. It deliberately does not feed the penalty engine (SPEC §5.4 computes
/// from `lateWorkingDays` and the user's profile, nothing else); a manager
/// re-attributing a delay must never quietly change someone's deduction.
enum DelayAttribution {
  WORKER
  CLIENT
  INTERNAL
  DEPENDENCY
}

/// The activity feed's vocabulary. Not a SPEC §4 enum — SPEC types
/// `TaskActivity.type` loosely — so the values are recorded in
/// docs/DECISIONS.md alongside `ProjectMemberRole`/`MilestoneStatus`.
///
/// `from`/`to` carry the change as strings, whatever the type: statuses for
/// STATUS_CHANGED, user ids for ASSIGNED, ISO instants for DUE_DATE_CHANGED.
/// SPEC §4 gives the row exactly `type, from, to` and no metadata column, and
/// that constraint is kept — anything richer belongs in the AuditLog row the
/// same operation writes.
enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  WATCHER_ADDED
  WATCHER_REMOVED
  COMMENTED
  DUE_DATE_CHANGED
  VALUE_CHANGED
  UPDATED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  ELAPSED_RECOMPUTED
}

model Task {
  id          String  @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?

  /// The one accountable person (SPEC §4 `assigneeId?`). Watchers are the
  /// many; see `TaskWatcher`. Null only while the task sits in BACKLOG.
  assigneeId String?

  status   TaskStatus @default(BACKLOG)
  priority Priority   @default(MEDIUM)

  /// Stable id of a Settings-defined category (`tasks.categories`), not its
  /// Arabic label — so renaming a category in Settings never orphans a task.
  /// Required, per the SPEC §4 listing (no `?`, unlike `milestoneId?` and
  /// `assigneeId?` beside it); validated against the live Settings list on
  /// write. See docs/DECISIONS.md (Phase 4).
  categoryId String

  /// Hours, not money — but `Decimal` all the same: it is divided by working
  /// elapsed time for the estimate-accuracy score (SPEC §5.6), and a float
  /// there would drift the same way a float payout would.
  estimatedHours Decimal @default(0) @db.Decimal(6, 2)

  /// What the assignee earns on approval (SPEC §5.1: "APPROVED is the only
  /// event that creates an EARNING ledger entry"). Auto-filled from the
  /// assignee's `defaultTaskRate` on assignment, editable per task.
  taskValue Decimal @default(0) @db.Decimal(12, 2)

  /// Required, per the SPEC §4 listing (no `?`, unlike `assigneeId?` beside
  /// it) and because the whole lateness engine measures against it.
  dueDate         DateTime
  /// The deadline the task was first given. An approved extension (Phase 6)
  /// moves `dueDate` and leaves this alone (SPEC §5.3).
  originalDueDate DateTime

  /// Stamped by the state machine, never by hand. `assignedAt`, `startedAt`
  /// and `approvedAt` are stamped once and never overwritten; `submittedAt` is
  /// re-stamped by every re-submission, with the original preserved in
  /// `TaskActivity` (SPEC §5.1).
  assignedAt  DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?

  /// Denormalised, job-updated (SPEC §4). Raw is wall-clock; working excludes
  /// weekends, holidays and approved leave via `lib/calendar` (SPEC §5.2).
  /// Derived values only — `modules/task/elapsed.ts` is the one writer.
  elapsedMinutesRaw     Int @default(0)
  elapsedMinutesWorking Int @default(0)

  /// Denormalised in the same sense as the two columns above, and written by
  /// the same nightly job (Phase 6, `modules/calendar/job.ts`): how many
  /// working days past `dueDate + grace` this task is, and how far that has
  /// escalated under the Settings thresholds (SPEC §8). Derived values only —
  /// the authority is always `modules/lateness/service.ts` recomputing from
  /// `lib/calendar`. They exist so the escalation decision is auditable and so
  /// project health can read "is anything escalated here" as an indexed count
  /// rather than by walking the calendar for every task on every dashboard.
  overdueWorkingDays Int             @default(0)
  escalationLevel    EscalationLevel @default(NONE)
  escalatedAt        DateTime?

  delayReason      String?
  delayAttribution DelayAttribution?

  /// 1–5, captured on approval and feeding the performance score (SPEC §5.6).
  /// Not in the SPEC §4 Task listing — a Phase 4 addition, recorded in
  /// docs/DECISIONS.md and added to SPEC §4.
  qualityRating Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project       Project            @relation(fields: [projectId], references: [id])
  milestone     Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  watchers      TaskWatcher[]
  comments      TaskComment[]
  activity      TaskActivity[]
  extensions    ExtensionRequest[]
  ledgerEntries LedgerEntry[]
  /// Tasks this one waits on, and the ones waiting on it.
  dependencies  TaskDependency[]   @relation("TaskDependent")
  dependents    TaskDependency[]   @relation("TaskDependedOn")

  @@index([deletedAt])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([milestoneId])
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([priority])
  @@index([categoryId])
  @@index([projectId, escalationLevel])
  @@map("tasks")
}

/// The many, to the assignee's one. Watchers see the task under
/// `task.view.assigned` (SPEC §6) and are notified about it (SPEC §8), but are
/// not accountable for it and never earn from it.
///
/// No `deletedAt`, matching `ProjectMember`/`UserRole`: a watcher is added and
/// removed outright.
model TaskWatcher {
  taskId  String
  userId  String
  addedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

/// Finish-to-start, **warning only, never blocking** (SPEC §4, §5.1). There is
/// deliberately no database constraint or application guard that stops a task
/// starting while `dependsOnTask` is unapproved — the product surfaces a banner
/// and lets the human decide.
model TaskDependency {
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task          Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependedOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// SPEC §4: `id, taskId, authorId, body, mentions[]`. No attachments, no
/// uploads — the only file input in the product is in-memory `.xlsx`
/// (CLAUDE.md invariant 9).
///
/// `mentions` holds resolved user ids, not the raw `@handles`: the handle is a
/// display detail that a rename would break, and the id is what the notifier
/// (Phase 9) actually needs.
model TaskComment {
  id       String   @id @default(cuid())
  taskId   String
  authorId String
  body     String
  mentions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

/// The human-readable history of one task (SPEC §4). Distinct from `AuditLog`,
/// and both are written: the audit row is the compliance record (actor, ip,
/// before/after diff, queryable across entities), this is the feed a منفّذ
/// reads on the task itself.
///
/// Append-only in practice — nothing updates or deletes a row — because
/// SPEC §5.1 makes it load-bearing: it is where a task's *original*
/// `submittedAt` survives re-submission, and where `BLOCKED → previous`
/// recovers what "previous" was.
model TaskActivity {
  id      String           @id @default(cuid())
  taskId  String
  /// Null for scheduler/system activity (the elapsed-time recompute job).
  actorId String?
  type    TaskActivityType
  from    String?
  to      String?

  /// Set explicitly from the operation's `now`, never left to the database
  /// clock: this column *is* the historical timestamp the SPEC relies on.
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([taskId, type, createdAt])
  @@index([actorId])
  @@map("task_activity")
}

// ─────────────────────────────────────────────────────────────────────────
// Calendar — Phase 6 slice (SPEC §4 "Calendar", §5.2, §5.3).
//
// SPEC §4 lists three things here: `WorkCalendar`, `Holiday` and `Leave`.
// Only two of them are tables. **`WorkCalendar` is not a model** — weekend
// days, workday bounds and working-days-per-month are already Settings keys
// (`calendar.*`, SPEC §7), and CLAUDE.md invariant 4 says every business
// number comes from `lib/settings`. A second, authoritative copy in a
// single-row table would be exactly the drift that invariant exists to stop.
// `lib/calendar` materialises the Settings group into a `WorkCalendar` value
// object instead — the shape SPEC §4 describes, sourced where §7 says.
//
// Dates here are `@db.Date`, not `DateTime`. A holiday and a leave range are
// *calendar dates in Cairo*, not instants: "7 يناير is a holiday" is true for
// the whole Cairo day, and storing 00:00Z would make that statement depend on
// which side of midnight a reader's timezone sits. `lib/calendar` is the one
// place that converts between a Cairo date key and a UTC instant.
// ─────────────────────────────────────────────────────────────────────────

/// SPEC §4 gives `Leave … status` without enumerating it. Three values, and
/// no CANCELLED: the phase brief's vocabulary is "approve/reject", and a
/// request withdrawn before a decision is rejected by whoever handles it. A
/// fourth value would be a second way to say "this leave does not apply",
/// which is one more state every lateness query has to remember to exclude.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// SPEC §4 lists this one verbatim: `status(PENDING|APPROVED|REJECTED)`.
enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// How far an overdue task has escalated (SPEC §8; thresholds in Settings,
/// `notifications.escalateToPmAfterDays` / `…AdminAfterDays`).
///
/// Stored rather than derived on read because the escalation *event* — the
/// notification Phase 9 delivers — must fire exactly once per level change.
/// A value recomputed on every read has no way to know it has already fired.
enum EscalationLevel {
  NONE
  PM
  ADMIN
}

/// SPEC §4: `Holiday id, date, nameAr`. Plus `isRecurring`, which the phase
/// brief asks for: عيد الميلاد المجيد falls on 7 January every year, while
/// عيد الفطر moves and must be entered per year.
///
/// No `deletedAt`, matching `Milestone` and the SPEC §4 listing. A holiday is
/// calendar configuration, not a record of anything that happened: a
/// soft-deleted one that a query forgot to filter would keep being a day off,
/// which is the failure mode soft-delete is supposed to prevent, inverted.
model Holiday {
  id     String   @id @default(cuid())
  /// Cairo calendar date. For a recurring holiday the year is the first
  /// occurrence and only month/day are matched.
  date   DateTime @db.Date
  nameAr String

  isRecurring Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per date. Overlapping *coverage* (a one-off inside a recurring
  /// holiday's month/day) is rejected in the service, where recurrence can be
  /// reasoned about; this constraint is the backstop for the exact-duplicate
  /// case a race could still produce.
  @@unique([date])
  @@index([isRecurring])
  @@map("holidays")
}

/// SPEC §4: `Leave id, userId, startDate, endDate, type, status, note`.
///
/// Three columns are added to that listing and each earns its place: leave is
/// approved by someone (`decidedById`/`decidedAt`, the same pair SPEC §4 gives
/// `ExtensionRequest`), and it can be *recorded* for a منفّذ by a manager
/// rather than requested by them (`requestedById`), which is the difference
/// between "أحمد asked for Thursday off" and "أحمد was out sick and المدير
/// logged it".
///
/// `startDate`/`endDate` are **inclusive** Cairo dates. A one-day leave has
/// `startDate == endDate`; there is no zero-length leave.
model Leave {
  id     String @id @default(cuid())
  /// Whose leave it is — the person the calendar excludes days for.
  userId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// Stable id from Settings `calendar.leaveTypes`, never the Arabic label —
  /// the same split SPEC §7 settled for `tasks.categories` in Phase 4, so
  /// renaming a leave type is a label change and not a re-typing of history.
  typeId String

  status LeaveStatus @default(PENDING)
  note   String?

  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User  @relation("LeaveSubject", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// The calendar's hot path: "APPROVED leave for this user overlapping this
  /// range". Overlap is `startDate <= to AND endDate >= from`, so both bounds
  /// are in the index.
  @@index([userId, status, startDate, endDate])
  @@index([status, startDate])
  @@index([requestedById])
  @@map("leaves")
}

/// SPEC §4, verbatim: `id, taskId, requestedById, oldDueDate, newDueDate,
/// reason, status, decidedById`.
///
/// `oldDueDate` is not decoration. It is the optimistic-concurrency check on
/// approval: if the task's deadline moved between request and decision — a
/// revision (SPEC T4) or another extension — the request is stale and
/// approving it would silently overwrite a newer decision.
model ExtensionRequest {
  id     String @id @default(cuid())
  taskId String

  requestedById String
  oldDueDate    DateTime
  newDueDate    DateTime
  reason        String

  status       ExtensionStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ExtensionRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("ExtensionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([status, createdAt])
  @@index([requestedById])
  @@map("extension_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// Money — Phase 7 slice (SPEC §4 "Money — immutable ledger", §5.5).
//
// This is the financial core, and it is built on one sentence from SPEC §4:
//
//     **Balance is always `SUM(amount)`.** There is no mutable balance column
//     anywhere.
//
// Everything below follows from taking that literally. A worker's balance is a
// single indexed aggregate over `ledger_entries`; a payout is what that
// aggregate said at the moment a cycle closed; a partial payment is a negative
// `PAYOUT` entry, so the remainder is still outstanding without anybody
// computing a remainder. Advances, carry-forward debt and part-payments need no
// special-case code at all — they are already arithmetic on one column.
// ─────────────────────────────────────────────────────────────────────────

/// SPEC §4, verbatim:
/// `EARNING | SALARY | PENALTY | BONUS | ADVANCE | ADJUSTMENT | PAYOUT | REVERSAL`.
///
/// SPEC §5.4's five formulas, and nothing else may be added without adding a
/// branch to `modules/penalty/calculate.ts` — which is the point of an enum
/// here rather than a stored expression (SPEC R2: "without a formula parser").
///
/// The `_PER_DAY` modes multiply by `lateWorkingDays`; the `_ONCE` modes do
/// not. That distinction is the whole difference between "every day you are
/// late costs you" and "being late costs you", and an operator picking between
/// them is making a policy decision, not a configuration one.
enum PenaltyMode {
  FIXED_PER_DAY
  PCT_TASK_VALUE_PER_DAY
  PCT_DAILY_RATE_PER_DAY
  FIXED_ONCE
  PCT_TASK_VALUE_ONCE
}

/// SPEC §4: `PenaltyProfile id, name, mode, value, graceHours, isDefault`, and
/// SPEC R2: "defaulted globally and overridable per user".
///
/// **`isDefault` is deliberately not a column.** SPEC §5.4 writes the lookup as
/// `profile = user.penaltyProfile ?? settings.defaultPenaltyProfile`, and SPEC
/// §7 already puts "Penalty defaults" in Settings — where `penalty.defaultMode`,
/// `penalty.defaultValue` and `penalty.defaultGraceHours` have lived since
/// Phase 0. A row flagged `isDefault` would be a second answer to "what is the
/// agency default", and the first thing that reads the wrong one deducts the
/// wrong amount from somebody. So the Settings triple *is*
/// `settings.defaultPenaltyProfile`, and this table holds only the named
/// overrides. Recorded in SPEC §4.
///
/// A profile is **shared, not per-user**: an agency assigns "خصم المصممين" to
/// eleven designers, and changing it once is the point. `User.penaltyProfileId`
/// is the many-to-one that makes that true.
model PenaltyProfile {
  id   String @id @default(cuid())
  /// Arabic, and the only name this entity has — nothing stores a reference to
  /// it by name, so unlike `tasks.categories` it needs no machine id.
  name String

  mode PenaltyMode

  /// Interpreted **per mode**: currency for `FIXED_*`, a percentage for
  /// `PCT_*`. Two columns would let a profile carry a percentage it does not
  /// use and disagree with itself; the mode is what gives this number meaning.
  ///
  /// `Decimal`, never `Float`, for the FIXED case — it is money — and the PCT
  /// case gets the same treatment because it is *multiplied by* money.
  /// Unsigned in practice: a negative penalty is a bonus, and
  /// `modules/penalty/schema.ts` refuses it rather than letting the ledger's
  /// sign check report it as a mysterious direction error.
  value Decimal @db.Decimal(12, 2)

  /// Overrides Settings `penalty.defaultGraceHours` for this person's work.
  /// Null means "the agency's grace" — the reason the column is nullable rather
  /// than defaulted, exactly as `Project.gracePeriodHours` beside it.
  ///
  /// The full chain is **project override → user profile → global default**
  /// (`modules/penalty/profile.ts`), which keeps SPEC §5.3's "project override
  /// → global default" literally true whenever a project has committed to a
  /// grace of its own. See docs/SPEC.md §5.4.
  graceHours Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]

  @@index([deletedAt])
  @@map("penalty_profiles")
}

/// The sign of `LedgerEntry.amount` is fixed per type and enforced in
/// `modules/ledger/service.ts` (`assertSignForType`): credits to the منفّذ are
/// positive, debits negative. That rule is what lets every balance, payout and
/// statement in the product be a `SUM` with no per-type branching.
enum LedgerEntryType {
  EARNING
  SALARY
  PENALTY
  BONUS
  ADVANCE
  ADJUSTMENT
  PAYOUT
  REVERSAL
}

/// SPEC §4: `PayoutCycle … status(OPEN|CLOSED|PAID)`.
/// `PAID` is reached automatically when every payout the cycle generated is
/// itself `PAID` — a derived state stored so "which cycles are still owed" is
/// an indexed query rather than a per-cycle sub-aggregate.
enum PayoutCycleStatus {
  OPEN
  CLOSED
  PAID
}

/// SPEC §4: `Payout … status(DRAFT|APPROVED|PAID)`, SPEC §5.5 for the edges.
enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
}

/// **INSERT ONLY.** Never updated, never deleted — in code *and* in the
/// database (see the trigger note at the bottom of this file). Corrections are
/// `REVERSAL` rows, which is why there is no `updatedAt` and no `deletedAt`
/// here, exactly as on `AuditLog`.
///
/// `amount` is signed. There is no separate debit/credit column and no
/// `direction` enum: a second representation of the sign is a second thing that
/// can disagree with the first, and every query in this product would then have
/// to remember which one to trust.
model LedgerEntry {
  id     String @id @default(cuid())
  /// The منفّذ this movement belongs to. Not the actor — see `createdById`.
  userId String

  /// The cycle this movement is *attributed* to, stamped from the open cycle at
  /// insert (`modules/payout/service.ts` → `ensureOpenCycle`). It is
  /// attribution for the statement, not the basis of the payout arithmetic:
  /// SPEC §4 says balance is a sum, so `net` is computed from the balance and
  /// cannot be wrong even if an entry lands on the far side of a cycle
  /// boundary. Nullable per the SPEC §4 listing, which is also what lets a
  /// future import land history that predates any cycle.
  cycleId String?

  type   LedgerEntryType
  amount Decimal         @db.Decimal(12, 2)

  /// Set on `EARNING` (which task was approved) and on the `PENALTY` rows
  /// Phase 8 writes. Never a foreign key the money depends on — a soft-deleted
  /// task must not make an earning disappear.
  taskId String?

  /// Arabic prose the منفّذ reads on their مستحقاتي page. Required, per the
  /// SPEC §4 listing (no `?`, unlike `taskId?` beside it): an entry that cannot
  /// explain itself is exactly what this product exists to abolish.
  note String

  /// True when a job or an event wrote this, false when a human did. Drives the
  /// "automatic" column on the statement, and Phase 8's "exactly one *active
  /// auto* PENALTY entry per task" (SPEC §5.4).
  isAutoGenerated Boolean @default(false)

  /// The entry this one reverses. `@unique`, which makes "reverse twice" fail
  /// at the database rather than at whichever code path forgot to check
  /// (docs/TESTING.md §4 axis 7).
  reversesEntryId String? @unique

  /// Null for scheduler/system writes, matching `AuditLog.actorId`.
  createdById String?
  createdAt   DateTime @default(now())

  user       User         @relation("LedgerSubject", fields: [userId], references: [id], onDelete: Restrict)
  cycle      PayoutCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  task       Task?        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdBy  User?        @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reverses   LedgerEntry? @relation("LedgerReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")

  /// Every referential action above is `Restrict`, including on the two
  /// optional relations where Prisma would default to `SetNull`. `SetNull`
  /// issues an `UPDATE` against this table, which the append-only trigger
  /// rejects — so the default would turn "delete this user" into a confusing
  /// trigger error instead of the honest foreign-key error it is. Nothing here
  /// is hard-deleted in practice: users, tasks and projects are soft-deleted.
  ///
  /// `[userId, createdAt]` is *the* balance index — `SUM(amount)` for one
  /// person, optionally as of an instant, in one indexed pass.
  @@index([userId, createdAt])
  /// Added in Phase 12 from a measured plan, not a guess.
  ///
  /// `balancesFor` — every منفّذ's balance at once, which the manager dashboard
  /// and the payouts screen both open with — is `SUM(amount) … WHERE userId IN
  /// (…) GROUP BY userId`. Against `[userId, createdAt]` that read the whole
  /// heap: `Seq Scan on ledger_entries`, 674 buffers, 9.7ms at 30k entries.
  /// Adding `amount` to the key makes it satisfiable from the index alone —
  /// `Index Only Scan`, **Heap Fetches: 0**, 184 buffers, 6.1ms. Same answer,
  /// a quarter of the I/O, and the gap widens with every month of history.
  ///
  /// It does not replace `[userId, createdAt]`: that one still serves the
  /// single-person statement and the as-of-an-instant balance, which need the
  /// ordering this index does not have.
  @@index([userId, amount])
  @@index([userId, cycleId])
  @@index([cycleId, type])
  @@index([taskId])
  @@index([type, createdAt])
  @@index([createdById])
  @@map("ledger_entries")
}

/// SPEC §4: `PayoutCycle id, periodStart, periodEnd, status, closedAt`.
///
/// Cycles are contiguous and non-overlapping: a new cycle opens at the previous
/// one's `periodEnd`, so every instant of the agency's history belongs to
/// exactly one cycle. At most one may be `OPEN` at a time, enforced by a
/// partial unique index (see the note at the bottom of this file).
model PayoutCycle {
  id          String            @id @default(cuid())
  periodStart DateTime
  /// The planned close instant — 23:59 Cairo on `settings.payout.cycleDay`.
  /// An early close (SPEC §5.5: "also closeable early by permission") moves it
  /// to the actual close instant, so the stored period never claims to cover
  /// time the cycle did not.
  periodEnd   DateTime
  status      PayoutCycleStatus @default(OPEN)
  closedAt    DateTime?
  /// Null when the scheduler closed it, set when a human closed it early.
  closedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closedBy User?         @relation("PayoutCycleClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  entries  LedgerEntry[]
  payouts  Payout[]

  @@index([status, periodStart])
  @@index([periodEnd])
  @@map("payout_cycles")
}

/// SPEC §4: `Payout id, userId, cycleId, gross, penalties, bonuses, advances,
/// net, status, paidAmount, method, reference, note, approvedById, paidAt`.
///
/// Three columns are added to that listing, and each exists to make the figure
/// reconcile on screen rather than only in the service that computed it:
///
///  - **`carriedForward`** — the balance the منفّذ brought into this cycle.
///    Without it, a worker whose deductions exceeded their earnings last month
///    sees a smaller `net` than `gross − penalties + bonuses − advances` and
///    has no way to see why. SPEC §5.4 promises exactly this carry-forward;
///    this is where it becomes visible.
///  - **`adjustments`** — the signed sum of `ADJUSTMENT` rows (SPEC M4's
///    "pay the previous assignee?"). They move `net`, so a breakdown that
///    omitted them would not add up.
///  - **`approvedAt` / `paidById`** — the counterparts of the `approvedById` /
///    `paidAt` the SPEC listing already has. Recording who approved but not
///    when, and when it was paid but not by whom, is half an answer to the only
///    question anybody asks of a payment record.
///
/// The identity the service maintains, and `tests/integration/payout` asserts:
///
///     net = max(0, carriedForward + gross − penalties + bonuses − advances + adjustments)
///
/// `net` is never negative (SPEC §5.4). The surplus is not stored — it is
/// simply the balance, which stays negative and becomes the next cycle's
/// `carriedForward`.
model Payout {
  id      String @id @default(cuid())
  userId  String
  cycleId String

  /// Signed. Negative when the منفّذ owed the agency at the cycle's start.
  carriedForward Decimal @default(0) @db.Decimal(12, 2)
  /// `EARNING + SALARY` for this cycle (SPEC §5.5).
  gross          Decimal @default(0) @db.Decimal(12, 2)
  /// Magnitudes, not signs: the ledger rows are negative, these columns are
  /// what a statement prints next to the word "خصم".
  penalties      Decimal @default(0) @db.Decimal(12, 2)
  bonuses        Decimal @default(0) @db.Decimal(12, 2)
  advances       Decimal @default(0) @db.Decimal(12, 2)
  /// Signed — an adjustment can credit or debit.
  adjustments    Decimal @default(0) @db.Decimal(12, 2)
  net            Decimal @default(0) @db.Decimal(12, 2)

  status PayoutStatus @default(DRAFT)

  /// Accumulates across partial payments; never exceeds `net` (SPEC §5.5).
  /// A mutable column, and legitimately so — `Payout` is a working document,
  /// not the ledger. Each payment also appends a negative `PAYOUT` entry, and
  /// that entry is the permanent record.
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  /// A snapshot of the Arabic label chosen from Settings `payout.paymentMethods`
  /// at the moment of payment, not a reference to it. SPEC §7 settled that the
  /// list is "the one remaining plain list of Arabic strings, and correctly so —
  /// nothing stores a reference to it"; a payment record must keep saying
  /// "فودافون كاش" even after the operator renames the entry.
  method    String?
  reference String?
  note      String?

  approvedById String?
  approvedAt   DateTime?
  paidById     String?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation("PayoutSubject", fields: [userId], references: [id], onDelete: Restrict)
  cycle      PayoutCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy     User?       @relation("PayoutPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  /// One payout per person per cycle. This is the database half of "two
  /// concurrent closes produce one payout per worker" — the advisory lock is
  /// the first half, and a unique index is what makes the guarantee survive a
  /// lock that was never taken (docs/TESTING.md §4 axis 6).
  @@unique([userId, cycleId])
  @@index([cycleId, status])
  @@index([userId, status])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications — Phase 9 (SPEC §8).
// ─────────────────────────────────────────────────────────────────────────

/// Every event SPEC §8 names, plus the two the codebase already had a domain
/// event for and this phase is the first subscriber to (`MONEY_REVERSED` from
/// Phase 8's `MoneyEventBus`, `TASK_ESCALATED` from Phase 6's
/// `LatenessEventBus`). `TASK_ASSIGNED` and `TASK_OVERDUE` are the two SPEC §8
/// says cannot be disabled — enforced in `modules/notification/service.ts`,
/// not by a schema constraint, because "cannot be disabled" is a rule about a
/// write path and Prisma has no way to express it declaratively.
enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_SUBMITTED
  TASK_REVISION_REQUESTED
  TASK_APPROVED
  TASK_ESCALATED
  TASK_MENTIONED
  PENALTY_APPLIED
  BONUS_GRANTED
  MONEY_REVERSED
  PAYOUT_APPROVED
  PAYOUT_PAID
  EXTENSION_REQUESTED
  EXTENSION_DECIDED
  MANAGER_DIGEST
}

/// One row per delivered notification. Mutable (`isRead`/`readAt`), unlike
/// `LedgerEntry` and `AuditLog` — a notification is a to-do, not a permanent
/// record, and CLAUDE.md's append-only invariant is about money, not inbox
/// state. The permanent record of *why* it fired is the domain event's own
/// audit row, written by the module that raised the event.
model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  /// Arabic prose, composed once at delivery from `i18n/ar` templates and the
  /// event payload (`modules/notification/messages.ts`) — so the bell, the
  /// drawer and the digest summary can never show a different sentence for the
  /// same event.
  title String
  body  String

  /// What the deep link resolves to. Both null for `MANAGER_DIGEST`, whose
  /// action is "open the drawer and read the summary", not "go to one entity".
  entityType String?
  entityId   String?

  /// The structured payload behind `body` — a penalty's breakdown, a digest's
  /// counts — kept for a future re-render or a summary view, the same reason
  /// `PenaltyAppliedEvent` carries a whole `PenaltyBreakdownDto` rather than an
  /// id pair (`modules/penalty/ports.ts`).
  payload Json?

  /// SPEC §5.4: a penalty notification is non-dismissable. Carried on the row
  /// rather than derived from `type` at render time, because whether a
  /// specific delivery may be dismissed is the emitting module's decision
  /// (see `PenaltyAppliedEvent.dismissable`), not a lookup table here.
  dismissable Boolean @default(true)

  isRead Boolean   @default(false)
  readAt DateTime?

  /// De-duplicates a threshold-crossing or scheduled delivery so a job replay
  /// or a redeploy cannot send the same notification twice — e.g.
  /// `${taskId}:${dueDate.toISOString()}` for `TASK_DUE_SOON`, a Cairo date key
  /// for `MANAGER_DIGEST`. Null for one-shot events that are already unique by
  /// their own domain rule (a task is approved once). Null values do not
  /// collide under Postgres unique-index semantics, so one-shot deliveries are
  /// never blocked by this column.
  dedupeKey String?

  createdAt DateTime @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Per-user overrides only — a missing row means "enabled", the same
/// missing-means-default reasoning `lib/settings` uses for the agency-wide
/// catalog. `TASK_ASSIGNED` and `TASK_OVERDUE` may never be written `false`;
/// enforced in `modules/notification/service.ts.setPreference`.
model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  enabled Boolean

  user User @relation("NotificationPreferenceOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────────────
// Performance & reporting — Phase 10 (SPEC §5.6).
// ─────────────────────────────────────────────────────────────────────────

/// The cached performance score (SPEC §5.6). "Computed on demand with a
/// cached daily recomputation" (phase brief) means two writers share this row:
/// `modules/performance/job.ts`'s nightly sweep, and a cache-miss read that
/// computes fresh rather than showing a brand-new worker nothing.
///
/// Deliberately **not** append-only, unlike `LedgerEntry`/`AuditLog` — this is
/// a cache in the same sense `LoginThrottle` is, not a financial or audit
/// record. CLAUDE.md invariant 1 is about the ledger; a performance score has
/// no "correction" concept because penalties and bonuses never touch it
/// (SPEC §5.6, "money only, per G9"), so there is nothing here a REVERSAL-style
/// row would ever need to undo — only a fresher number to overwrite it with.
model PerformanceScore {
  userId String @id

  /**
   * The weighted composite, 0–100.
   */
  score            Decimal @db.Decimal(5, 2)
  /**
   * Each component already normalised to 0–100, before its weight is applied.
   */
  onTimeRate       Decimal @db.Decimal(5, 2)
  qualityScore     Decimal @db.Decimal(5, 2)
  volumeScore      Decimal @db.Decimal(5, 2)
  estimateAccuracy Decimal @db.Decimal(5, 2)

  /**
   * How many completed tasks the score was computed over — 0 is a real, valid score.
   */
  taskCount Int @default(0)

  computedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([computedAt])
  @@map("performance_scores")
}

// ─────────────────────────────────────────────────────────────────────────
// Objects this schema cannot express, created by raw SQL in
// `prisma/migrations/20260818000000_money_ledger_payouts/migration.sql`.
//
// **Preserve them.** Prisma's schema language has no syntax for a trigger or a
// partial index, so `prisma migrate dev` will propose dropping these the next
// time it diffs. They are load-bearing:
//
//  1. `ledger_entries_append_only()` + two `BEFORE UPDATE / BEFORE DELETE`
//     triggers. CLAUDE.md invariant 1 in the one place it cannot be argued
//     with. Row-level triggers do not fire on `TRUNCATE`, so
//     `tests/setup/reset.ts` still works.
//  2. `ledger_entries_one_earning_per_task` — UNIQUE (taskId) WHERE
//     type = 'EARNING'. "Approving twice must not double-pay", enforced where
//     two concurrent approvals cannot both win.
//  3. `ledger_entries_one_salary_per_cycle` — UNIQUE (userId, cycleId) WHERE
//     type = 'SALARY'. SPEC §5.5's "one SALARY entry per salaried worker per
//     cycle", which is also what makes the accrual job idempotent.
//  4. `payout_cycles_single_open` — UNIQUE ((status)) WHERE status = 'OPEN'.
//     Two open cycles would mean two answers to "which cycle is this entry in".
// ─────────────────────────────────────────────────────────────────────────
