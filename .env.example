# ─────────────────────────────────────────────────────────────────────────────
# Virallap — environment
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (docker-compose maps postgres to 5432):
DATABASE_URL="postgresql://agency:agency@localhost:5432/agency?schema=public"

# The integration suite promotes TEST_DATABASE_URL over DATABASE_URL at startup
# (tests/setup/db-guard.ts), because Prisma only ever reads DATABASE_URL.
# The runner then refuses any database whose name does not end in _test.
# This is a hard guard, not a convention.
TEST_DATABASE_URL="postgresql://agency:agency@localhost:5432/agency_test?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Auth.js signs the JWT with this; without it every request 500s.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin, used by Auth.js for callback URLs. Behind Dokploy's proxy the
# app also sets `trustHost`, so this is the externally visible origin.
AUTH_URL="http://localhost:3000"

# Login throttling and password policy are NOT env vars — they live in Settings
# (`security.maxLoginAttempts`, `security.loginWindowMinutes`,
# `security.lockoutMinutes`, `security.minPasswordLength`) so they can be changed
# during an incident without a redeploy. See CLAUDE.md invariant 4.

# ── Seed ────────────────────────────────────────────────────────────────────
# The first SUPER_ADMIN. Required by `pnpm db:seed`.
# The seed does NOT force a password change on first login — pick a real password.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FULL_NAME=""

# ── Scheduler ───────────────────────────────────────────────────────────────
# Only ONE instance should run jobs. The Postgres advisory lock makes a second
# runner harmless, but leaving it off elsewhere is cheaper.
ENABLE_SCHEDULER="false"

# ── Runtime ─────────────────────────────────────────────────────────────────
TZ="Africa/Cairo"
NODE_ENV="development"
